# Field Work backend configuration
NODE_ENV=production
PORT=5000

# Point this at the Invoice Generator MongoDB database.
# `mongodb` resolves only when this backend joins the Docker network containing that service.
MONGO_URI=mongodb://mongodb:27017/ocellus

# Must match the Invoice Generator JWT signing secret for shared login.
JWT_SECRET=replace-with-the-same-long-random-secret-used-by-invoice-generator

# Public web origin for cookies/CORS. Replace with your Field Work HTTPS domain.
COOKIE_DOMAIN=.ocellus.co.in
CORS_ORIGIN=https://field.ocellus.co.in

# Push notifications (use the VAPID keys generated for Field Work).
VAPID_PUBLIC_KEY=replace-with-field-work-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-field-work-vapid-private-key
VAPID_SUBJECT=mailto:amr@ocellus.co.in

# Docker network name that contains Invoice Generator's MongoDB.
# Find the real name with: docker network ls
INVOICE_DOCKER_NETWORK=database-network-ocellus

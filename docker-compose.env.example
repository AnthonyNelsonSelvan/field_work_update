# Copy this file to .env beside docker-compose.yml and fill in the server values.
FIELD_DESK_URL=https://field.ocellus.co.in
INVOICE_APP_URL=https://ocellus.co.in
COOKIE_DOMAIN=.ocellus.co.in
SESSION_DAYS=365

# Set this to the actual project-prefixed Invoice app-network name from docker network ls.
INVOICE_DOCKER_NETWORK=replace-with-invoice-app-network-name

# Use the same Mongo URI and JWT secret as Invoice Generator.
MONGO_URI=mongodb://mongodb:27017/Invoice
JWT_SECRET=replace-with-the-exact-invoice-jwt-secret

DAILY_REMINDER_HOUR=9
VAPID_PUBLIC_KEY=replace-with-generated-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-generated-vapid-private-key
VAPID_SUBJECT=mailto:notifications@ocellus.co.in
